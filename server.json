{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.IVYEnergy/aivy-mcp",
  "title": "Aivy Energy",
  "description": "Read and control your own home solar + battery: Sungrow, Sigenergy, FoxESS, AlphaESS, SolaX.",
  "version": "0.9.4",
  "websiteUrl": "https://bridge.ivyenergy.com.au/developers",
  "repository": {
    "url": "https://github.com/IVYEnergy/aivy-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "aivy-mcp",
      "version": "0.9.4",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "AIVY_API_KEY",
          "description": "Personal Aivy API key (aivy_sk_...). Optional: without one, register_account or sign_in creates and stores a key from the chat.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "AIVY_API_URL",
          "description": "API base URL. Default https://bridge.ivyenergy.com.au/v1",
          "isRequired": false,
          "isSecret": false,
          "default": "https://bridge.ivyenergy.com.au/v1"
        }
      ]
    }
  ]
}
